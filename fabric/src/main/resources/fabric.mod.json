{
  "schemaVersion": 1,
  "id": "pathadol",
  "version": "${version}",

  "name": "Pathadol",
  "description": "A fully humanized fork of Baritone. Baritone's pathfinding brain with human-like camera, movement, mining, bridging and combat.",
  "authors": [
    "5ivesaw"
  ],
  "contributors": [
    "leijurv", "Brady", "Baritone contributors"
  ],
  "contact": {
    "homepage": "https://github.com/5ivesaw/pathadol",
    "sources": "https://github.com/5ivesaw/pathadol",
    "issues": "https://github.com/5ivesaw/pathadol/issues"
  },

  "license": "LGPL-3.0",
  "icon": "assets/pathadol/icon.png",

  "environment": "*",
  "entrypoints": {
  },
  "mixins": [
      "mixins.pathadol.json"
  ],
  "provides": [
      "baritone"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3"
  },
  "breaks": {
    "baritone-meteor": "*"
  }
}
